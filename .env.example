# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram ID админов (через запятую). Узнать свой ID: @userinfobot
# Админы всегда имеют доступ и решают, кого ещё пустить в бота.
ADMIN_IDS=123456789
# К кому отправлять людей без доступа (username без @)
ADMIN_CONTACT=oldarsi
# Ключ шифрования паролей в БД. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
DB_PATH=data/bot.db
HOSTVDS_AUTH_URL=https://os-api.hostvds.com/identity
HOSTVDS_PUBLIC_API=https://hostvds.com/api
SELECTEL_API_URL=https://api.vscale.io/v1
TIMEWEB_API_URL=https://api.timeweb.cloud
AEZA_API_URL=https://my.aeza.net/api
# Максимум созданий серверов за одну задачу (включая удалённые) — защита от слива баланса
MAX_ATTEMPTS=50
# Быстрый режим HostVDS: сколько IP проверить через порты (бесплатно) и сколько одновременно
MAX_PORT_ATTEMPTS=500
PORT_PARALLEL=10
# Разведка IP Selectel: максимум серверов за раз и сколько проверять одновременно (1 = строго по одному)
SCAN_MAX=200
SCAN_PARALLEL=1
# Сколько серверов создавать одновременно
PARALLEL=3
# Сколько секунд ждать статуса ACTIVE
ACTIVE_TIMEOUT=300
# Размер загрузочного диска (ГБ), если у тарифа нет локального диска
BOOT_VOLUME_GB=10
# Названия локаций вручную (если автоопределение страны ошиблось), формат:
# REGION_NAMES=eu-west1=NL:Amsterdam,us-west=US:Silicon Valley
REGION_NAMES=

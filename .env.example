# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram ID админов (через запятую). Узнать свой ID: @userinfobot
# Админы всегда имеют доступ и решают, кого ещё пустить в бота.
ADMIN_IDS=123456789
# К кому отправлять людей без доступа (username без @)
ADMIN_CONTACT=oldarsi
# Ключ шифрования паролей в БД. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
DB_PATH=data/bot.db
HOSTVDS_AUTH_URL=https://os-api.hostvds.com/identity
HOSTVDS_PUBLIC_API=https://hostvds.com/api
SELECTEL_API_URL=https://api.vscale.io/v1
TIMEWEB_API_URL=https://api.timeweb.cloud
AEZA_API_URL=https://my.aeza.net/api
SERVERSPACE_API_URL=https://api.serverspace.ru
DO_API_URL=https://api.digitalocean.com/v2
# Публичный список подсетей DigitalOcean по городам
DO_GEOFEED_URL=https://www.digitalocean.com/geo/google.csv
HETZNER_API_URL=https://api.hetzner.cloud/v1
HETZNER_GEOFEED_URL=https://www.hetzner.com/geofeed.csv
VULTR_API_URL=https://api.vultr.com/v2
VULTR_GEOFEED_URL=https://geofeed.constant.com/
LINODE_API_URL=https://api.linode.com/v4
LINODE_GEOFEED_URL=https://geoip.linode.com/
CIVO_API_URL=https://api.civo.com/v2
# Максимум созданий серверов за одну покупку (0 = без лимита, остановить можно кнопкой ⛔)
PURCHASE_ATTEMPT_LIMIT=0
# Быстрый режим (порты HostVDS, резервные IP Vultr/Hetzner/Civo): сколько IP проверить (0 = без лимита) и сколько одновременно
IP_HUNT_LIMIT=0
PORT_PARALLEL=10
# Разведка IP Selectel: максимум серверов за раз и сколько проверять одновременно (1 = строго по одному)
SCAN_MAX=200
SCAN_PARALLEL=1
# Сколько серверов создавать одновременно
PARALLEL=3
# Сколько секунд ждать статуса ACTIVE
ACTIVE_TIMEOUT=300
# Размер загрузочного диска (ГБ), если у тарифа нет локального диска
BOOT_VOLUME_GB=10
# Названия локаций вручную (если автоопределение страны ошиблось), формат:
# REGION_NAMES=eu-west1=NL:Amsterdam,us-west=US:Silicon Valley
REGION_NAMES=
# Покупка «Только рабочий»: какую страницу бот открывает с нового сервера (через SSH) и сколько секунд
# ждёт, пока сервер начнёт пускать по SSH
CHECK_URL=https://turkmenistanairlines.tm/
CHECK_SSH_TIMEOUT=300
# Если провайдер снова и снова выдаёт тот же IP (Linode и др.), бот держит до N неподходящих серверов
# до конца покупки, чтобы получить другие адреса (0 = не держать)
HOLD_SERVERS=100
